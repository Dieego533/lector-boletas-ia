# Base de datos local PostgreSQL.
# Se usa sólo si DATABASE_URL no está definida.
DATABASE_PASSWORD=

# URL completa de PostgreSQL para Supabase/producción.
# Usa el Session pooler de Supabase y sslmode=require.
DATABASE_URL=

# Claves de servicios IA/OCR.
GEMINI_API_KEY=
GROQ_API_KEY=
OCR_SPACE_API_KEY=

# Motor por defecto: auto, vision u ocr_text.
AI_ENGINE=auto

# Protección por clave compartida.
# true bloquea rutas de la app hasta ingresar la clave.
# false deja la app abierta.
APP_ACCESS_LOCK_ENABLED=false

# Clave compartida de acceso. No subir ni exponer.
APP_ACCESS_PASSWORD=