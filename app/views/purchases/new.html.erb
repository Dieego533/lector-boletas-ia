<div class="back-row">
  <%= link_to purchases_path, class: "back-link" do %>
    <span class="material-symbols-outlined">arrow_back</span>
    Volver
  <% end %>
</div>

<header class="upload-header">
  <h1>
    <span class="material-symbols-outlined">receipt_long</span>
    Subir boleta
  </h1>
  <p>Sube una boleta en formato PDF, JPG o PNG. El tamaño máximo permitido es 10 MB.</p>
</header>

<% if notice.present? %>
  <p class="notice"><%= notice %></p>
<% end %>

<% if @processing_error.present? %>
  <p class="alert"><%= @processing_error %></p>
<% end %>

<div class="upload-grid">
  <section class="upload-card">
    <%= form_with url: preview_purchases_path, multipart: true, data: { turbo: false, processing_form: true }, class: "upload-form" do %>
      <div class="upload-card-title">
        <span class="material-symbols-outlined">cloud_upload</span>
        <h2>Archivo de boleta</h2>
      </div>

      <label class="dropzone" for="receipt-input" data-dropzone>
        <span class="material-symbols-outlined dropzone-icon">upload_file</span>
        <strong data-file-label>Haga clic o arrastre su boleta aquí</strong>
      </label>
      <p class="field-error" data-file-error hidden></p>
      <%= file_field_tag :receipt, id: "receipt-input", accept: "application/pdf,image/png,image/jpeg", class: "file-input", data: { file_input: true } %>

      <div class="mobile-camera-action">
        <label class="camera-button" for="receipt-camera-input">
          <span class="material-symbols-outlined">photo_camera</span>
          Tomar foto
        </label>
        <%= file_field_tag :receipt_camera, id: "receipt-camera-input", accept: "image/*", capture: "environment", class: "file-input", data: { camera_input: true } %>
      </div>

      <div class="processing-methods">
        <label>Método de procesamiento</label>

        <div class="method-options">
          <label class="method-option">
            <%= radio_button_tag :ai_engine, "auto", ReceiptProcessor.default_engine == "auto" %>
            <span>
              <strong>⭐ Automático</strong>
              <small>El sistema decide cuál es el mejor método para procesar tu boleta.</small>
            </span>
          </label>

          <label class="method-option">
            <%= radio_button_tag :ai_engine, "vision", ReceiptProcessor.default_engine == "vision" %>
            <span>
              <strong>Análisis inteligente</strong>
              <small>Ideal para archivos grandes, fotos difíciles o documentos con mala iluminación.</small>
            </span>
          </label>

          <label class="method-option">
            <%= radio_button_tag :ai_engine, "ocr_text", ReceiptProcessor.default_engine == "ocr_text" %>
            <span>
              <strong>Extracción de datos</strong>
              <small>Rápido para fotos claras o archivos con buen detalle.</small>
            </span>
          </label>
        </div>
      </div>

      <%= button_tag type: :submit, class: "process-button", disabled: true, data: { process_button: true } do %>
        <span class="material-symbols-outlined">bolt</span>
        <span data-process-button-label>Procesar boleta</span>
      <% end %>
    <% end %>
  </section>

  <section class="preview-card">
    <div class="preview-card-header">
      <div>
        <span class="material-symbols-outlined">visibility</span>
        <h2>Vista previa</h2>
      </div>

    </div>

    <div class="preview-stage">
      <div class="receipt-placeholder">
        <div class="receipt-paper">
          <span class="material-symbols-outlined">receipt_long</span>
          <strong data-preview-title>Vista previa de boleta</strong>
          <small data-preview-subtitle>Selecciona un archivo para procesarlo.</small>
        </div>
      </div>
    </div>
  </section>
</div>

<div class="loading-modal" data-loading-modal hidden>
  <div class="loading-modal-card">
    <div class="loading-icon">
      <span class="material-symbols-outlined">receipt_long</span>
    </div>

    <h2>Leyendo recibo...</h2>
    <p>Espera un momento mientras extraemos los datos de tu boleta.</p>

    <div class="loading-progress" aria-hidden="true">
      <span></span>
    </div>
  </div>
</div>

<script>
  (() => {
    window.setupUploadForm = window.setupUploadForm || (() => {
      const dropzone = document.querySelector("[data-dropzone]");
      const input = document.querySelector("[data-file-input]");
      const cameraInput = document.querySelector("[data-camera-input]");
      const label = document.querySelector("[data-file-label]");
      const fileError = document.querySelector("[data-file-error]");
      const paper = document.querySelector(".receipt-paper");
      const form = document.querySelector("[data-processing-form]");
      const modal = document.querySelector("[data-loading-modal]");
      const processButton = document.querySelector("[data-process-button]");
      const processButtonLabel = document.querySelector("[data-process-button-label]");

      if (!dropzone || !input || !label || !paper) return;
      if (dropzone.dataset.uploadReady) return;

      dropzone.dataset.uploadReady = "true";

      const MAX_IMAGE_SIZE = 1.5 * 1024 * 1024;
      const MAX_IMAGE_DIMENSION = 1800;
      const JPEG_QUALITY = 0.85;
      const MAX_FILE_SIZE = 10 * 1024 * 1024;
      const ALLOWED_TYPES = ["application/pdf", "image/jpeg", "image/png"];
      let selectedFileValid = false;
      let preparingFile = false;

      const setProcessButtonState = (enabled, text = "Procesar boleta") => {
        if (processButton) processButton.disabled = !enabled;
        if (processButtonLabel) processButtonLabel.textContent = text;
      };

      const showFileError = (message) => {
        if (fileError) {
          fileError.textContent = message;
          fileError.hidden = false;
        }
        dropzone.classList.add("is-invalid");
      };

      const clearFileError = () => {
        if (fileError) {
          fileError.textContent = "";
          fileError.hidden = true;
        }
        dropzone.classList.remove("is-invalid");
      };

      const resetPreview = () => {
        if (paper.dataset.previewUrl) {
          URL.revokeObjectURL(paper.dataset.previewUrl);
          delete paper.dataset.previewUrl;
        }

        paper.innerHTML = `
          <span class="material-symbols-outlined">receipt_long</span>
          <strong data-preview-title>Vista previa de boleta</strong>
          <small data-preview-subtitle>Selecciona un archivo para procesarlo.</small>
        `;
      };

      const clearSelectedFile = () => {
        selectedFileValid = false;
        if (input) input.value = "";
        if (cameraInput) cameraInput.value = "";
        label.textContent = "Haga clic o arrastre su boleta aquí";
        resetPreview();
        setProcessButtonState(false);
      };

      const validationMessage = (file) => {
        if (!file) return "Debes subir una boleta para continuar.";
        const validExtension = /\.(pdf|jpe?g|png)$/i.test(file.name);
        if (!ALLOWED_TYPES.includes(file.type) && !validExtension) return "El archivo debe ser PDF, JPG o PNG.";
        if (file.size > MAX_FILE_SIZE) return "El archivo no puede superar los 10 MB.";

        return null;
      };

      const replaceInputFile = (targetInput, file) => {
        if (!targetInput || !file || typeof DataTransfer === "undefined") return;

        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(file);
        targetInput.files = dataTransfer.files;
      };

      const compressImage = (file) => new Promise((resolve) => {
        if (!file.type.startsWith("image/") || file.size <= MAX_IMAGE_SIZE) {
          resolve(file);
          return;
        }

        const image = new Image();
        const objectUrl = URL.createObjectURL(file);

        image.onload = () => {
          const scale = Math.min(1, MAX_IMAGE_DIMENSION / Math.max(image.width, image.height));
          const canvas = document.createElement("canvas");
          canvas.width = Math.round(image.width * scale);
          canvas.height = Math.round(image.height * scale);

          const context = canvas.getContext("2d");
          context.drawImage(image, 0, 0, canvas.width, canvas.height);

          canvas.toBlob((blob) => {
            URL.revokeObjectURL(objectUrl);

            if (!blob || blob.size >= file.size) {
              resolve(file);
              return;
            }

            const compressedFile = new File([blob], file.name.replace(/\.[^.]+$/, ".jpg"), {
              type: "image/jpeg",
              lastModified: Date.now()
            });

            resolve(compressedFile);
          }, "image/jpeg", JPEG_QUALITY);
        };

        image.onerror = () => {
          URL.revokeObjectURL(objectUrl);
          resolve(file);
        };

        image.src = objectUrl;
      });

      const setFile = async (file, targetInput) => {
        const message = validationMessage(file);
        if (message) {
          clearSelectedFile();
          showFileError(message);
          return;
        }

        clearFileError();
        selectedFileValid = false;
        preparingFile = true;
        setProcessButtonState(false, "Preparando imagen...");

        const processedFile = await compressImage(file);
        replaceInputFile(targetInput, processedFile);
        preparingFile = false;
        selectedFileValid = true;

        label.textContent = processedFile === file ? processedFile.name : `${processedFile.name} (optimizada)`;

        if (paper.dataset.previewUrl) {
          URL.revokeObjectURL(paper.dataset.previewUrl);
          delete paper.dataset.previewUrl;
        }

        if (processedFile.type.startsWith("image/")) {
          const reader = new FileReader();
          reader.onload = (event) => {
            paper.innerHTML = `<img src="${event.target.result}" alt="Vista previa de boleta">`;
            setProcessButtonState(true);
          };
          reader.readAsDataURL(processedFile);
          return;
        }

        if (processedFile.type === "application/pdf") {
          const previewUrl = URL.createObjectURL(processedFile);
          paper.dataset.previewUrl = previewUrl;
          paper.innerHTML = `<iframe src="${previewUrl}" title="Vista previa de boleta PDF"></iframe>`;
          setProcessButtonState(true);
          return;
        }

        paper.innerHTML = `
          <span class="material-symbols-outlined">picture_as_pdf</span>
          <strong>${processedFile.name}</strong>
          <small>El PDF se procesará al presionar Procesar boleta.</small>
        `;
        setProcessButtonState(true);
      };

      dropzone.addEventListener("dragover", (event) => {
        event.preventDefault();
        dropzone.classList.add("is-dragging");
      });

      dropzone.addEventListener("dragleave", () => {
        dropzone.classList.remove("is-dragging");
      });

      dropzone.addEventListener("drop", (event) => {
        event.preventDefault();
        dropzone.classList.remove("is-dragging");

        if (event.dataTransfer.files.length > 0) {
          input.files = event.dataTransfer.files;
          setFile(event.dataTransfer.files[0], input);
        }
      });

      input.addEventListener("click", () => {
        input.value = "";
        if (cameraInput) cameraInput.value = "";
      });

      input.addEventListener("change", () => {
        if (cameraInput) cameraInput.value = "";
        setFile(input.files[0], input);
      });

      if (cameraInput) {
        cameraInput.addEventListener("click", () => {
          cameraInput.value = "";
          input.value = "";
        });

        cameraInput.addEventListener("change", () => {
          input.value = "";
          setFile(cameraInput.files[0], cameraInput);
        });
      }

      if (form && modal) {
        form.addEventListener("submit", (event) => {
          if (preparingFile) {
            event.preventDefault();
            showFileError("Espera a que terminemos de preparar la imagen.");
            return;
          }

          if (!selectedFileValid) {
            event.preventDefault();
            showFileError("Debes subir una boleta para continuar.");
            setProcessButtonState(false);
            return;
          }

          modal.hidden = false;
          setProcessButtonState(false, "Procesando...");
        });
      }
    });

    window.resetUploadFormBeforeCache = window.resetUploadFormBeforeCache || (() => {
      const dropzone = document.querySelector("[data-dropzone]");
      const input = document.querySelector("[data-file-input]");
      const cameraInput = document.querySelector("[data-camera-input]");
      const fileError = document.querySelector("[data-file-error]");
      const paper = document.querySelector(".receipt-paper");
      const modal = document.querySelector("[data-loading-modal]");

      if (dropzone) {
        dropzone.classList.remove("is-dragging");
        dropzone.classList.remove("is-invalid");
        delete dropzone.dataset.uploadReady;
      }

      if (input) input.value = "";
      if (cameraInput) cameraInput.value = "";
      if (fileError) {
        fileError.textContent = "";
        fileError.hidden = true;
      }
      if (paper?.dataset.previewUrl) {
        URL.revokeObjectURL(paper.dataset.previewUrl);
        delete paper.dataset.previewUrl;
      }
      if (modal) modal.hidden = true;
    });

    if (!window.uploadFormListenersReady) {
      document.addEventListener("DOMContentLoaded", window.setupUploadForm);
      document.addEventListener("turbo:load", window.setupUploadForm);
      document.addEventListener("turbo:before-cache", window.resetUploadFormBeforeCache);
      window.uploadFormListenersReady = true;
    }

    window.setupUploadForm();
  })();
</script>
