<% if purchase.errors.any? %>
  <div class="form-errors">
    <h2>No se pudo guardar</h2>
    <ul>
      <% purchase.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: purchase, class: "purchase-edit-form" do |form| %>
  <%= hidden_field_tag :return_to, local_assigns[:return_to] if local_assigns[:return_to].present? %>

  <div class="purchase-edit-fields">
    <div class="field-full">
      <%= form.label :merchant_name, "Comercio" %>
      <%= form.text_field :merchant_name, placeholder: "Nombre del comercio" %>
    </div>

    <div>
      <%= form.label :merchant_rut, "RUT comercio" %>
      <%= form.text_field :merchant_rut, placeholder: "76.123.456-7" %>
    </div>

    <div>
      <%= form.label :document_number, "Número de documento" %>
      <%= form.text_field :document_number, placeholder: "Ej: 123456" %>
    </div>

    <div>
      <%= form.label :purchase_date, "Fecha de compra" %>
      <%= form.date_field :purchase_date %>
    </div>

    <div>
      <%= form.label :total_amount, "Total" %>
      <%= form.number_field :total_amount, step: 1, min: 0, placeholder: "0", value: purchase.total_amount.present? ? purchase.total_amount.to_i : purchase.total_amount %>
    </div>
  </div>

  <div class="items-review edit-items-review">
    <div class="items-review-header">
      <div>
        <span class="material-symbols-outlined">list_alt</span>
        <h3>Desglose de items</h3>
      </div>
      <button type="button" class="add-item-button" data-add-item>
        <span class="material-symbols-outlined">add</span>
        Agregar fila
      </button>
    </div>

    <%= render "purchases/items_fields", form: form %>
  </div>

  <div class="purchase-edit-actions">
    <%= link_to "Cancelar", local_assigns.fetch(:cancel_path, purchases_path), class: "button button-secondary" %>
    <%= form.submit submit_text, class: "save-review-button" %>
  </div>
<% end %>
