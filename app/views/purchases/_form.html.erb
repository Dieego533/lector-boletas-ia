<!-- Inicio errores de validación -->
<% if purchase.errors.any? %>
  <div class="form-errors">
    <h2>No se pudo guardar</h2>
    <ul>
      <% purchase.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<!-- Fin errores de validación -->

<% field_error_class = ->(field) { "field-error-input" if purchase.errors[field].any? } %>

<!-- Inicio formulario de compra -->
<%= form_with model: purchase, class: "purchase-edit-form" do |form| %>
  <%= hidden_field_tag :return_to, local_assigns[:return_to] if local_assigns[:return_to].present? %>

  <!-- Inicio datos principales -->
  <div class="purchase-edit-fields">
    <div class="field-full">
      <%= form.label :merchant_name, "Comercio o RUT comercio *" %>
      <%= form.text_field :merchant_name, class: field_error_class.call(:merchant_name) %>
    </div>

    <div>
      <%= form.label :merchant_rut, "RUT comercio" %>
      <%= form.text_field :merchant_rut, class: field_error_class.call(:merchant_rut) %>
    </div>

    <div>
      <%= form.label :document_number, "Número de documento *" %>
      <%= form.text_field :document_number, class: field_error_class.call(:document_number) %>
    </div>

    <div>
      <%= form.label :purchase_date, "Fecha de compra *" %>
      <%= form.date_field :purchase_date, class: field_error_class.call(:purchase_date) %>
    </div>

    <div>
      <%= form.label :total_amount, "Total *" %>
      <%= form.number_field :total_amount, step: 1, min: 1, class: field_error_class.call(:total_amount), value: purchase.total_amount.present? ? purchase.total_amount.to_i : purchase.total_amount %>
    </div>

    <div>
      <%= form.label :tax_amount, "IVA" %>
      <%= form.number_field :tax_amount, step: 1, min: 0, class: field_error_class.call(:tax_amount), value: purchase.tax_amount.present? ? purchase.tax_amount.to_i : purchase.tax_amount %>
    </div>
  </div>
  <!-- Fin datos principales -->

  <!-- Inicio desglose de productos -->
  <div class="items-review edit-items-review">
    <div class="items-review-header">
      <div>
        <span class="material-symbols-outlined">list_alt</span>
        <h3>Desglose de items</h3>
      </div>
      <button type="button" class="add-item-button" data-add-item>
        <span class="material-symbols-outlined">add</span>
        Agregar fila
      </button>
    </div>

    <%= render "purchases/items_total_warning", purchase: purchase %>
    <%= render "purchases/items_fields", form: form %>
  </div>
  <!-- Fin desglose de productos -->

  <!-- Inicio acciones del formulario -->
  <div class="purchase-edit-actions">
    <%= link_to "Cancelar", local_assigns.fetch(:cancel_path, purchases_path), class: "button button-secondary" %>
    <%= form.submit submit_text, class: "save-review-button" %>
  </div>
  <!-- Fin acciones del formulario -->
<% end %>
<!-- Fin formulario de compra -->
