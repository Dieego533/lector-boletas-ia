<header class="review-header">
  <div>
    <h1>Revisa la información antes de guardar</h1>
    <p>Los campos son editables. La compra sólo se guardará cuando presiones Guardar compra.</p>
  </div>
</header>

<% if notice.present? %>
  <p class="notice"><%= notice %></p>
<% end %>

<% if @processing_error.present? %>
  <p class="alert"><%= @processing_error %></p>
<% end %>

<div class="review-layout">
  <section class="review-receipt-card">
    <div class="review-card-header">
      <div>
        <span class="material-symbols-outlined">receipt_long</span>
        <h2>Boleta original</h2>
      </div>

      <% if @preview_file.present? %>
        <small><%= @preview_file[:filename] %></small>
      <% end %>
    </div>

    <div class="review-receipt-stage">
      <% if @preview_file.present? && @preview_file[:content_type].start_with?("image/") %>
        <div class="receipt-zoom-frame" data-receipt-zoom>
          <%= link_to @preview_file[:data_url], target: "_blank", rel: "noopener", class: "open-receipt-button", aria: { label: "Abrir boleta en otra pestaña" } do %>
            <span class="material-symbols-outlined">open_in_new</span>
          <% end %>
          <img src="<%= @preview_file[:data_url] %>" alt="Boleta original" data-receipt-zoom-image>
          <div class="receipt-magnifier" data-receipt-magnifier aria-hidden="true"></div>
        </div>
      <% elsif @preview_file.present? && @preview_file[:content_type] == "application/pdf" %>
        <div class="receipt-zoom-frame pdf-frame">
          <%= link_to @preview_file[:data_url], target: "_blank", rel: "noopener", class: "open-receipt-button", aria: { label: "Abrir boleta en otra pestaña" } do %>
            <span class="material-symbols-outlined">open_in_new</span>
          <% end %>
          <iframe src="<%= @preview_file[:data_url] %>" title="Boleta original"></iframe>
        </div>
      <% else %>
        <div class="receipt-unavailable">
          <span class="material-symbols-outlined">image_not_supported</span>
          <strong>Vista previa no disponible</strong>
          <small>No se muestra preview para archivos mayores a 3 MB. Revisa los datos extraídos a la derecha.</small>
        </div>
      <% end %>
    </div>
  </section>

  <section class="review-form-card">
    <% field_error_class = ->(field) { "field-error-input" if @purchase.errors[field].any? } %>

    <%= form_with model: @purchase, url: purchases_path, class: "review-form" do |form| %>
      <%= form.hidden_field :raw_text, value: @raw_text %>
      <%= form.hidden_field :processing_error, value: @processing_error %>
      <%= form.hidden_field :ai_response, value: JSON.generate(@ai_response || {}) %>

      <div class="review-card-header compact">
        <div>
          <span class="material-symbols-outlined">edit_note</span>
          <h2>Datos extraídos</h2>
        </div>
      </div>

      <div class="review-fields">
        <div class="field-full">
          <%= form.label :merchant_name, "Comercio o RUT comercio *" %>
          <%= form.text_field :merchant_name, class: field_error_class.call(:merchant_name) %>
        </div>

        <div>
          <%= form.label :merchant_rut, "RUT comercio" %>
          <%= form.text_field :merchant_rut, class: field_error_class.call(:merchant_rut) %>
        </div>

        <div>
          <%= form.label :document_number, "N° documento *" %>
          <%= form.text_field :document_number, class: field_error_class.call(:document_number) %>
        </div>

        <div>
          <%= form.label :purchase_date, "Fecha de compra *" %>
          <%= form.date_field :purchase_date, class: field_error_class.call(:purchase_date) %>
        </div>

        <div>
          <%= form.label :total_amount, "Total *" %>
          <%= form.number_field :total_amount, step: 1, min: 1, class: field_error_class.call(:total_amount), value: @purchase.total_amount.present? ? @purchase.total_amount.to_i : @purchase.total_amount %>
        </div>

        <div>
          <%= form.label :tax_amount, "IVA" %>
          <%= form.number_field :tax_amount, step: 1, min: 0, class: field_error_class.call(:tax_amount), value: @purchase.tax_amount.present? ? @purchase.tax_amount.to_i : @purchase.tax_amount %>
        </div>
      </div>

      <div class="items-review">
        <div class="items-review-header">
          <div>
            <span class="material-symbols-outlined">list_alt</span>
            <h3>Desglose de items</h3>
          </div>
          <button type="button" class="add-item-button" data-add-item>
            <span class="material-symbols-outlined">add</span>
            Agregar fila
          </button>
        </div>

        <%= render "purchases/items_total_warning", purchase: @purchase %>
        <%= render "purchases/items_fields", form: form %>
      </div>

      <div class="review-actions">
        <%= link_to "Cancelar", purchases_path, class: "button button-secondary" %>
        <%= form.submit "Guardar compra", class: "save-review-button" %>
      </div>
    <% end %>
  </section>
</div>

<div id="success_modal_root"></div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("[data-receipt-zoom]").forEach((frame) => {
      const image = frame.querySelector("[data-receipt-zoom-image]");
      const magnifier = frame.querySelector("[data-receipt-magnifier]");
      if (!image) return;

      const zoom = 1.7;
      const size = 150;

      const setMagnifierBackground = () => {
        if (!magnifier) return;

        magnifier.style.backgroundImage = `url(${image.src})`;
        magnifier.style.backgroundSize = `${image.offsetWidth * zoom}px ${image.offsetHeight * zoom}px`;
      };

      if (image.complete) {
        setMagnifierBackground();
      } else {
        image.addEventListener("load", setMagnifierBackground, { once: true });
      }

      window.addEventListener("resize", setMagnifierBackground);

      frame.addEventListener("mousemove", (event) => {
        if (!magnifier) return;

        const rect = frame.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;

        magnifier.style.left = `${x}px`;
        magnifier.style.top = `${y}px`;
        magnifier.style.backgroundPosition = `${-(x * zoom - size / 2)}px ${-(y * zoom - size / 2)}px`;
      });

      frame.addEventListener("mouseleave", () => {
        if (!magnifier) return;

        magnifier.style.left = "50%";
        magnifier.style.top = "50%";
      });
    });

    const modalRoot = document.getElementById("success_modal_root");
    if (modalRoot) {
      const observer = new MutationObserver(() => {
        if (window.setupSuccessRedirect) window.setupSuccessRedirect();
      });
      observer.observe(modalRoot, { childList: true });
    }
  });
</script>
