<div class="back-row">
  <%= link_to purchases_path, class: "back-link" do %>
    <span class="material-symbols-outlined">arrow_back</span>
    Volver
  <% end %>
</div>

<div class="purchase-detail-header">
  <div>
    <h1>
      <span class="material-symbols-outlined">receipt_long</span>
      Detalle de compra
    </h1>
    <p>Información guardada y datos de procesamiento de la boleta.</p>
  </div>

  <div class="purchase-detail-actions">
    <%= link_to edit_purchase_path(@purchase, return_to: purchase_path(@purchase)), class: "detail-action-button edit" do %>
      <span class="material-symbols-outlined">edit</span>
      Editar
    <% end %>

    <%= button_to purchase_path(@purchase), method: :delete, form: { data: { turbo_confirm: "¿Eliminar esta compra?" } }, class: "detail-action-button danger" do %>
      <span class="material-symbols-outlined">delete</span>
      Eliminar
    <% end %>
  </div>
</div>

<% if notice.present? %>
  <p class="notice"><%= notice %></p>
<% end %>

<div class="purchase-detail-layout">
  <section class="detail-card ai-card">
    <div class="detail-card-title">
      <div>
        <span class="material-symbols-outlined">psychology</span>
        <h2>Procesamiento IA</h2>
      </div>
    </div>

    <div class="ai-facts">
      <div class="ai-fact">
        <span>Opción seleccionada</span>
        <strong><%= @purchase.ai_engine_label.presence || "No registrada" %></strong>
      </div>

      <div class="ai-fact">
        <span>Método utilizado</span>
        <strong><%= @purchase.resolved_ai_engine_label.presence || "No registrado" %></strong>
      </div>

      <div class="ai-fact">
        <span>Modelo usado</span>
        <strong class="model-value">
          <i></i>
          <%= @purchase.ai_model.presence || "No registrado" %>
        </strong>
      </div>

      <div class="ai-fact">
        <span>Fecha de registro</span>
        <strong><%= @purchase.created_at.in_time_zone.strftime("%d-%m-%Y %H:%M") %></strong>
      </div>

      <% if @purchase.processing_error.present? %>
        <div class="ai-fact error">
          <span>Error de procesamiento</span>
          <strong><%= @purchase.processing_error %></strong>
        </div>
      <% end %>
    </div>

    <div class="detail-accordions">
      <% if @purchase.ai_data.present? %>
        <details class="detail-accordion">
          <summary>
            <span>
              <span class="material-symbols-outlined">arrow_right</span>
              Ver respuesta IA
            </span>
            <small>JSON</small>
          </summary>
          <pre><%= JSON.pretty_generate(@purchase.ai_data) %></pre>
        </details>
      <% end %>

      <% if @purchase.raw_text.present? %>
        <details class="detail-accordion">
          <summary>
            <span>
              <span class="material-symbols-outlined">arrow_right</span>
              Ver texto OCR
            </span>
            <small>RAW</small>
          </summary>
          <pre><%= @purchase.raw_text %></pre>
        </details>
      <% end %>
    </div>
  </section>

  <section class="detail-card data-card">
    <div class="detail-card-title simple">
      <div>
        <span class="material-symbols-outlined">receipt_long</span>
        <h2>Datos de la compra</h2>
      </div>
    </div>

    <div class="purchase-data-grid">
      <div class="purchase-data-item full">
        <span>Comercio</span>
        <strong><%= @purchase.merchant_name.presence || "No informado" %></strong>
      </div>

      <div class="purchase-data-item">
        <span>RUT comercio</span>
        <strong><%= @purchase.merchant_rut.presence || "No informado" %></strong>
      </div>

      <div class="purchase-data-item">
        <span>Número de documento</span>
        <strong><%= @purchase.document_number.presence || "No informado" %></strong>
      </div>

      <div class="purchase-data-item">
        <span>Fecha</span>
        <strong><%= @purchase.purchase_date.present? ? @purchase.purchase_date.strftime("%d-%m-%Y") : "No informada" %></strong>
      </div>

      <div class="purchase-data-item total">
        <span>Total</span>
        <strong><%= @purchase.total_amount.present? ? number_to_currency(@purchase.total_amount, unit: "$", precision: 0, delimiter: ".", separator: ",") : "No informado" %></strong>
      </div>

      <div class="purchase-data-item">
        <span>IVA</span>
        <strong><%= @purchase.tax_amount.present? ? number_to_currency(@purchase.tax_amount, unit: "$", precision: 0, delimiter: ".", separator: ",") : "No informado" %></strong>
      </div>
    </div>

    <div class="product-breakdown">
      <div class="product-breakdown-title">
        <span class="material-symbols-outlined">list_alt</span>
        <h3>Desglose de productos</h3>
      </div>

      <% if @purchase.purchase_items.any? %>
        <div class="products-table-card">
          <table class="products-table">
            <thead>
              <tr>
                <th>Cant.</th>
                <th>Descripción</th>
                <th class="text-right">Precio</th>
                <th class="text-right">Desc.</th>
                <th class="text-right">Total</th>
              </tr>
            </thead>
            <tbody>
              <% @purchase.purchase_items.each do |item| %>
                <tr>
                  <td data-label="Cantidad"><%= item.quantity.to_i %></td>
                  <td data-label="Descripción"><%= item.description %></td>
                  <td class="text-right" data-label="Precio"><%= item.unit_price.present? ? number_to_currency(item.unit_price, unit: "$", precision: 0, delimiter: ".", separator: ",") : "-" %></td>
                  <td class="text-right" data-label="Descuento"><%= item.discount_amount.to_i.positive? ? "-#{number_to_currency(item.discount_amount, unit: "$", precision: 0, delimiter: ".", separator: ",")}" : "-" %></td>
                  <td class="text-right" data-label="Total"><%= item.total_price.present? ? number_to_currency(item.total_price, unit: "$", precision: 0, delimiter: ".", separator: ",") : "-" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="products-table-card">
          <table class="products-table empty-products-table">
            <thead>
              <tr>
                <th>Cant.</th>
                <th>Descripción</th>
                <th class="text-right">Precio</th>
                <th class="text-right">Desc.</th>
                <th class="text-right">Total</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td colspan="5" class="empty-products-message">No hay productos en el desglose.</td>
              </tr>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </section>
</div>
